NODE_ENV=development
PORT=3000
SERVER_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
REDIS_URL=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=debug

# Sign in with Apple — required ONLY to enable Apple token revocation on account
# deletion (App Store 5.1.1(v)). From the Apple Developer portal:
#   APPLE_TEAM_ID   = your 10-char Team ID
#   APPLE_KEY_ID    = the Key ID of the Sign-in-with-Apple key (.p8)
#   APPLE_CLIENT_ID = the Services ID / app bundle id used for Sign in with Apple
#                     (the `aud` of the Apple identity tokens, e.g. com.happycheeksltd.halcyon)
#   APPLE_PRIVATE_KEY = the full .p8 contents (PEM). Newlines may be written as \n on one line.
# If these are unset, sign-in still works and deletion still removes the account;
# only the Apple-side token revocation is skipped.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=

